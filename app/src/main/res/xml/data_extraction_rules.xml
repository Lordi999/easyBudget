<?xml version="1.0" encoding="utf-8"?>
<!-- Backup ab Android 12: alles sichern außer dem verschlüsselten API-Key (secrets.xml). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secrets.xml" />
    </device-transfer>
</data-extraction-rules>
